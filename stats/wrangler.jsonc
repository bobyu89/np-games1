// 霧脈公會的匿名使用統計。一個 Worker 加一個放資料的 Durable Object（裡面是 SQLite），
// 所以部署只要一個指令，不用另外建資料庫。怎麼部署看 README.md。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mist-guild-stats",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    // 哪些網址的遊戲可以回傳統計、可以看總表。多個用逗號分開。本機（localhost、127.0.0.1）一律可以
    "ALLOW_ORIGINS": "https://bobyu89.github.io"
  },
  "durable_objects": { "bindings": [{ "name": "STATS", "class_name": "Stats" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Stats"] }]
}
